{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "**/*.py",
      "pyproject.toml",
      "uv.lock",
      "Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "uv run uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/docs",
    "restartPolicyType": "ON_FAILURE",
    "restartMaxRetries": 3
  }
}